# Template for local API keys used by the frontier judge backends (eval/backends.py).
# Copy this file to `.env` and fill in the key for whichever judge you use:
#
#     cp .env.example .env
#
# `.env` is gitignored — never commit real keys. A key exported in your shell takes
# precedence over anything here. Requires the `eval` extra (`uv pip install -e '.[eval]'`),
# which includes python-dotenv.

# Anthropic (Claude judge) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini judge — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

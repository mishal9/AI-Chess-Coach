# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Data (large public dumps + generated artifacts)
data/raw/
data/processed/
*.pgn
*.pgn.zst
*.bin
# …but keep small checked-in test fixtures + the eval held-out set
!tests/data/*.pgn
!eval/heldout/*.pgn

# Models / training artifacts (Modelfiles are tiny config — keep those;
# models/* not models/ so the negation below can reach into the directory)
models/*
!models/Modelfile*
*.gguf
*.safetensors
# Phase 3 distillation artifacts: bulky + reproducible (regenerate via training.*).
# NOTE: git has no inline comments — keep these as bare patterns on their own lines.
data/games/
data/distill/*
training/datasets/*/*.jsonl
# ...but VERSION the moat: it cost real Opus calls to make and isn't cheaply reproducible.
# The v1 splits + the raw teacher output are committed; intermediate part/chunk files are not.
!data/distill/raw_v1.jsonl
!training/datasets/v1/*.jsonl
!data/distill/raw_v2.jsonl
!training/datasets/v2/*.jsonl
# (each dataset version's manifest.json — the provenance receipt — is committed too.)

# Env / secrets
.env

# OS
.DS_Store
